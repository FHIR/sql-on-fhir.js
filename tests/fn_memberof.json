  "tests": [
    {
      "title": "Coding member and non-member",
      "description": "Within a forEach over code.coding, memberOf tests each Coding on its own.",
      "tags": ["terminology"],
      "view": {
        "resource": "Observation",
        "select": [
          {
            "column": [
              {
                "name": "id",
                "path": "id",
                "type": "id"
              }
            ]
          },
          {
            "forEach": "code.coding",
            "column": [
              {
                "name": "code",
                "path": "code",
                "type": "code"
              },
              {
                "name": "is_vital_sign",
                "path": "memberOf('http://hl7.org/fhir/ValueSet/observation-vitalsignresult')",
                "type": "boolean"
              }
            ]
          }
        ]
      },
      "expect": [
        {
          "id": "o1",
          "code": "8867-4",
          "is_vital_sign": true
        },
        {
          "id": "o1",
          "code": "HR",
          "is_vital_sign": false
        },
        {
          "id": "o2",
          "code": "2339-0",
          "is_vital_sign": false
        },
        {
          "id": "o3",
          "code": "8310-5",
          "is_vital_sign": true
        }
      ]
    },
    {
      "title": "CodeableConcept is a member when any coding is",
      "description": "A CodeableConcept is a member when at least one of its codings is, and not a member when none is.",
      "tags": ["terminology"],
      "view": {
        "resource": "Observation",
        "select": [
          {
            "column": [
              {
                "name": "id",
                "path": "id",
                "type": "id"
              },
              {
                "name": "is_vital_sign",
                "path": "code.memberOf('http://hl7.org/fhir/ValueSet/observation-vitalsignresult')",
                "type": "boolean"
              }
            ]
          }
        ]
      },
      "expect": [
        {
          "id": "o1",
          "is_vital_sign": true
        },
        {
          "id": "o2",
          "is_vital_sign": false
        },
        {
          "id": "o3",
          "is_vital_sign": true
        }
      ]
    },
    {
      "title": "code element against a single-system value set",
      "description": "A code element is tested against a value set that contains codes from one code system.",
      "tags": ["terminology"],
      "view": {
        "resource": "Observation",
        "select": [
          {
            "column": [
              {
                "name": "id",
                "path": "id",
                "type": "id"
              },
              {
                "name": "is_complete",
                "path": "status.memberOf('http://example.org/ValueSet/observation-status-complete')",
                "type": "boolean"
              }
            ]
          }
        ]
      },
      "expect": [
        {
          "id": "o1",
          "is_complete": true
        },
        {
          "id": "o2",
          "is_complete": true
        },
        {
          "id": "o3",
          "is_complete": false
        }
      ]
    },
    {
      "title": "string against a single-system value set",
      "description": "A string is a member when it equals a code in a value set that contains codes from one code system.",
      "tags": ["terminology"],
      "view": {
        "resource": "Observation",
        "select": [
          {
            "column": [
              {
                "name": "id",
                "path": "id",
                "type": "id"
              },
              {
                "name": "final_is_complete",
                "path": "'final'.memberOf('http://example.org/ValueSet/observation-status-complete')",
                "type": "boolean"
              },
              {
                "name": "registered_is_complete",
                "path": "'registered'.memberOf('http://example.org/ValueSet/observation-status-complete')",
                "type": "boolean"
              }
            ]
          }
        ],
        "where": [
          {
            "path": "id = 'o1'"
          }
        ]
      },
      "expect": [
        {
          "id": "o1",
          "final_is_complete": true,
          "registered_is_complete": false
        }
      ]
    },
    {
      "title": "string against a multi-system value set is empty",
      "description": "memberOf on a string is empty when the value set contains codes from more than one code system.",
      "tags": ["terminology"],
      "view": {
        "resource": "Observation",
        "select": [
          {
            "column": [
              {
                "name": "id",
                "path": "id",
                "type": "id"
              },
              {
                "name": "single_system",
                "path": "'8867-4'.memberOf('http://hl7.org/fhir/ValueSet/observation-vitalsignresult')",
                "type": "boolean"
              },
              {
                "name": "multi_system",
                "path": "'8867-4'.memberOf('http://example.org/ValueSet/mixed-systems')",
                "type": "boolean"
              }
            ]
          }
        ],
        "where": [
          {
            "path": "id = 'o1'"
          }
        ]
      },
      "expect": [
        {
          "id": "o1",
          "single_system": true,
          "multi_system": null
        }
      ]
    },
    {
      "title": "input with more than one value is empty",
      "description": "memberOf is empty when its input has more than one value, so code.coding.memberOf() is empty for a resource with two codings.",
