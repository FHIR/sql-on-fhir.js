    {
      "title": "versioned canonical selects that version",
      "description": "A |version suffix on the canonical URL selects the matching version of the value set.",
      "tags": ["terminology"],
      "view": {
        "resource": "Observation",
        "select": [
          {
            "column": [
              {
                "name": "id",
                "path": "id",
                "type": "id"
              },
              {
                "name": "in_v1",
                "path": "status.memberOf('http://example.org/ValueSet/observation-status-final|1')",
                "type": "boolean"
              },
              {
                "name": "in_v2",
                "path": "status.memberOf('http://example.org/ValueSet/observation-status-final|2')",
                "type": "boolean"
              }
            ]
          }
        ]
      },
      "expect": [
        {
          "id": "o1",
          "in_v1": true,
          "in_v2": true
