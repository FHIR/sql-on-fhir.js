    {
      "title": "Vital Sign Observations example",
      "description": "The VitalSignObservations example from the Terminology Dependent View Definition profile, which calls memberOf in a where clause and in a column. The id column uses id rather than getResourceKey(), and the patient_id column is left out, because resource and reference keys are implementation dependent.",
      "tags": ["terminology"],
      "view": {
        "resource": "Observation",
        "constant": [
          {
            "name": "vital_signs",
            "valueCanonical": "http://hl7.org/fhir/ValueSet/observation-vitalsignresult|5.0.0"
          }
        ],
        "select": [
          {
            "column": [
              {
                "name": "id",
                "path": "id",
                "type": "id"
              },
              {
                "name": "effective_date_time",
                "path": "effective.ofType(dateTime)",
                "type": "dateTime"
              }
            ]
          },
          {
            "forEach": "code.coding",
            "column": [
              {
                "name": "system",
                "path": "system",
                "type": "uri"
              },
              {
                "name": "code",
                "path": "code",
                "type": "code"
              },
              {
                "name": "is_vital_sign",
                "path": "memberOf(%vital_signs)",
                "type": "boolean"
              }
            ]
          }
        ],
        "where": [
          {
            "path": "code.memberOf(%vital_signs)"
          }
        ]
      },
      "expect": [
        {
          "id": "o1",
          "effective_date_time": "2024-01-01T10:00:00Z",
          "system": "http://loinc.org",
          "code": "8867-4",
          "is_vital_sign": true
        },
        {
          "id": "o1",
          "effective_date_time": "2024-01-01T10:00:00Z",
          "system": "http://example.org/codes",
          "code": "HR",
          "is_vital_sign": false
        },
        {
          "id": "o3",
          "effective_date_time": "2024-01-03T10:00:00Z",
          "system": "http://loinc.org",
          "code": "8310-5",
          "is_vital_sign": true
        }
      ]
    }
