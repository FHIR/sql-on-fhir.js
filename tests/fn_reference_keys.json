{
  "title": "fn_reference_keys",
  "description": "TBD",
  "fhirVersion": ["5.0.0", "4.0.1", "3.0.2"],
  "resources": [
    {
      "resourceType": "Patient",
      "id": "p1",
      "link": [
        {
          "type": "seealso",
          "other": {
            "reference": "Patient/p1"
          }
        }
      ],
      "generalPractitioner": [
        {
          "reference": "Practitioner/pr1"
        },
        {
          "reference": "Organization/o1"
        },
        {
          "display": "Unknown practitioner"
        },
        {
          "reference": "Practitioner/pr2"
        }
      ]
    },
    {
      "resourceType": "Patient",
      "id": "p2",
      "link": [
        {
          "type": "seealso",
          "other": {
            "reference": "Patient/p3"
          }
        }
      ]
    }
  ],
  "tests": [
    {
      "title": "getReferenceKey result matches getResourceKey without type specifier",
      "tags": ["shareable"],
      "view": {
        "resource": "Patient",
        "select": [
          {
            "column": [
              {
                "path": "getResourceKey() = link.other.getReferenceKey()",
                "name": "key_equal_ref",
                "type": "boolean"
              }
            ]
          }
        ]
      },
      "expect": [
        {
          "key_equal_ref": true
        },
        {
          "key_equal_ref": false
        }
      ]
    },
    {
      "title": "getReferenceKey result matches getResourceKey with right type specifier",
      "tags": ["shareable"],
      "view": {
        "resource": "Patient",
        "select": [
          {
            "column": [
              {
                "path": "getResourceKey() = link.other.getReferenceKey(Patient)",
                "name": "key_equal_ref",
                "type": "boolean"
              }
            ]
          }
        ]
      },
      "expect": [
        {
          "key_equal_ref": true
        },
        {
          "key_equal_ref": false
        }
      ]
    },
    {
      "title": "getReferenceKey result matches getResourceKey with wrong type specifier",
      "tags": ["shareable"],
      "view": {
        "resource": "Patient",
        "select": [
          {
            "column": [
              {
                "path": "getResourceKey() = link.other.getReferenceKey(Observation)",
                "name": "key_equal_ref",
                "type": "boolean"
              }
            ]
          }
        ]
      },
      "expect": [
        {
          "key_equal_ref": null
        },
        {
          "key_equal_ref": null
        }
      ]
    },
    {
      "title": "getReferenceKey on a collection returns a key for each reference",
      "tags": ["shareable"],
      "view": {
        "resource": "Patient",
        "select": [
          {
            "column": [
              {
                "path": "id",
                "name": "id",
                "type": "id"
              },
              {
                "path": "generalPractitioner.getReferenceKey()[2].exists()",
                "name": "has_third_key",
                "type": "boolean"
              },
              {
                "path": "generalPractitioner.getReferenceKey()[3].exists()",
                "name": "has_fourth_key",
                "type": "boolean"
              }
            ]
          }
        ]
      },
      "expect": [
        {
          "id": "p1",
          "has_third_key": true,
          "has_fourth_key": false
        },
        {
          "id": "p2",
          "has_third_key": false,
          "has_fourth_key": false
        }
      ]
    },
    {
      "title": "getReferenceKey with type specifier on a collection filters each reference",
      "tags": ["shareable"],
      "view": {
        "resource": "Patient",
        "select": [
          {
            "column": [
              {
                "path": "id",
                "name": "id",
                "type": "id"
              },
              {
                "path": "generalPractitioner.getReferenceKey(Practitioner)[1].exists()",
                "name": "has_second_key",
                "type": "boolean"
              },
              {
                "path": "generalPractitioner.getReferenceKey(Practitioner)[2].exists()",
                "name": "has_third_key",
                "type": "boolean"
              }
            ]
          }
        ]
      },
      "expect": [
        {
          "id": "p1",
          "has_second_key": true,
          "has_third_key": false
        },
        {
          "id": "p2",
          "has_second_key": false,
          "has_third_key": false
        }
      ]
    },
    {
      "title": "getReferenceKey within forEachOrNull returns one key per reference",
      "tags": ["shareable"],
      "view": {
        "resource": "Patient",
        "select": [
          {
            "column": [
              {
                "path": "id",
                "name": "id",
                "type": "id"
              }
            ]
          },
          {
            "forEachOrNull": "generalPractitioner",
            "column": [
              {
                "path": "getReferenceKey(Practitioner) = getReferenceKey()",
                "name": "practitioner_key_matches",
                "type": "boolean"
              }
            ]
          }
        ]
      },
      "expect": [
        {
          "id": "p1",
          "practitioner_key_matches": true
        },
        {
          "id": "p1",
          "practitioner_key_matches": null
        },
        {
          "id": "p1",
          "practitioner_key_matches": null
        },
        {
          "id": "p1",
          "practitioner_key_matches": true
        },
        {
          "id": "p2",
          "practitioner_key_matches": null
        }
      ]
    },
    {
      "title": "getReferenceKey on multiple references fails in a single-valued column",
      "tags": ["shareable"],
      "view": {
        "resource": "Patient",
        "select": [
          {
            "column": [
              {
                "path": "generalPractitioner.getReferenceKey(Practitioner)",
                "name": "practitioner_key",
                "type": "string"
              }
            ]
          }
        ]
      },
      "expectError": true
    }
  ]
}
