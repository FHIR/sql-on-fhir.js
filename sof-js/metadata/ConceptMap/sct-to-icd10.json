      "target": "http://hl7.org/fhir/sid/icd-10|2019",
      "element": [
        {
          "code": "59621000",
          "display": "Essential hypertension",
          "target": [
            {
              "code": "I10",
              "display": "Essential (primary) hypertension",
              "relationship": "equivalent"
            }
          ]
        },
        {
          "code": "10509002",
          "display": "Acute bronchitis",
          "target": [
            {
              "code": "J20.9",
              "display": "Acute bronchitis, unspecified",
              "relationship": "equivalent"
            }
          ]
        },
        {
          "code": "195662009",
          "display": "Acute viral pharyngitis",
          "target": [
            {
              "code": "J02.9",
              "display": "Acute pharyngitis, unspecified",
              "relationship": "source-is-narrower-than-target"
            }
          ]
        },
        {
          "code": "271737000",
          "display": "Anemia",
          "target": [
            {
              "code": "D64.9",
              "display": "Anaemia, unspecified",
              "relationship": "equivalent"
            }
          ]
        },
        {
          "code": "414545008",
          "display": "Ischemic heart disease",
          "target": [
            {
              "code": "I25.9",
              "display": "Chronic ischaemic heart disease, unspecified",
              "relationship": "source-is-broader-than-target"
            }
          ]
        },
        {
          "code": "160903007",
          "display": "Full-time employment",
          "noMap": true,
          "comment": "A social finding has no counterpart in a classification of disease"
        }
      ]
